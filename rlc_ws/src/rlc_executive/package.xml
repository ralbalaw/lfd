<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rlc_executive</name>
  <version>0.0.0</version>
  <description>BehaviorTree-based executive layer for rlc: orchestrates state, planning via MoveIt,
    and execution.</description>
  <maintainer email="193288475+hasan-fahad1@users.noreply.github.com">Hasan Al Thobaiti</maintainer>
  <maintainer email="252933012+alb-rashed@users.noreply.github.com">Rashed Albalawi</maintainer>
  <license>Apache-2.0</license>
  <!-- See repo root LICENSE and NOTICE for terms and attribution. -->

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>generate_parameter_library</depend>

  <!-- Core ROS 2 -->
  <depend>rclcpp</depend>
  <depend>ament_index_cpp</depend>

  <!-- State -->
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Planning and execution interfaces -->
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_msgs</depend>
  <depend>rlc_interfaces</depend>
  <depend>rclcpp_action</depend>

  <!-- BT engine -->
  <depend>behaviortree_cpp</depend>
  <depend>behaviortree_ros2</depend>

  <!-- YAML config -->
  <depend>yaml_cpp_vendor</depend>

  <depend>rbt_irl</depend>
  <depend>rbt_features</depend>
  <depend>rbt_types</depend>
  <depend>rlc_utils</depend>
  <depend>rbt_planning</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
